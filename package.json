{
  "name": "@alphazede/bearing",
  "version": "0.1.6",
  "description": "Harness-agnostic orchestration for AI coding agents: approved plans, DAG-scheduled routes, bounded execution, and reviewable evidence.",
  "keywords": [
    "ai-agents",
    "coding-agent",
    "agent-orchestration",
    "claude-code",
    "codex",
    "developer-tools",
    "local-first",
    "workflow-automation",
    "dag",
    "evidence",
    "code-review",
    "cli"
  ],
  "author": "William Rumph / AlphaZede",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alphazede/bearing.git"
  },
  "homepage": "https://github.com/alphazede/bearing#readme",
  "bugs": {
    "url": "https://github.com/alphazede/bearing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/",
    "assets/",
    ".mcp.json",
    ".claude-plugin/",
    ".codex-plugin/",
    "plugin-skills/",
    "hooks/",
    "examples/fictional-b2b/",
    "skills/",
    "README.md",
    "SECURITY.md",
    "LICENSE-APACHE"
  ],
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "bin": {
    "bearing": "dist/cli.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "eval:native": "tsc && node dist/evaluation/cli.js native",
    "eval:skillsbench": "tsc && node dist/evaluation/cli.js skillsbench",
    "test:integration": "vitest run test/local-session.test.ts test/repository-bootstrap.test.ts test/repository-choice.test.ts test/onboarding-http.test.ts test/showcase-http.test.ts",
    "build": "tsc",
    "dist-guard": "pnpm build && node scripts/check-dist-freshness.mjs",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23"
    }
  }
}
