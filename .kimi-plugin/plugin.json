      "timeout": 15
    },
    {
      "event": "Stop",
      "command": "node ./hooks/com.anthropic.claude-code/host.cjs",
      "timeout": 15
    }
  ],
  "interface": {
    "displayName": "Bearing Lite",
    "shortDescription": "Skills-first repository workflow.",
    "longDescription": "Plan, route, execute, and independently review bounded repository work with portable skills.",
    "developerName": "William Rumph / AlphaZede"
  }
}
